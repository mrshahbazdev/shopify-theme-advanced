<div class="blog-page section-{{ section.id }}">
  <div class="page-width">
    <div class="blog-page__header">
      <h1 class="blog-page__title">{{ blog.title | escape }}</h1>
      {%- if blog.description != blank -%}<p class="blog-page__description">{{ blog.description }}</p>{%- endif -%}
    </div>
    {% paginate blog.articles by section.settings.articles_per_page %}
      <div class="blog-grid blog-grid--{{ section.settings.columns_desktop }}-col-desktop">
        {%- for article in blog.articles -%}
          <article class="blog-card">
            <a href="{{ article.url }}" class="blog-card__media">
              {%- if article.image != blank -%}
                <img src="{{ article.image | image_url: width: 800 }}" alt="{{ article.image.alt | escape }}" loading="lazy" width="800" height="{{ article.image.height | times: 1.0 | divided_by: article.image.width | times: 800 | round }}">
              {%- else -%}
                <div class="blog-card__placeholder">{{ article.title | escape }}</div>
              {%- endif -%}
            </a>
            <div class="blog-card__info">
              {%- if article.tags.size > 0 -%}<span class="blog-card__tag">{{ article.tags.first | escape }}</span>{%- endif -%}
              <h2 class="blog-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h2>
              <p class="blog-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 25 }}</p>
              <div class="blog-card__meta">
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
                <span class="blog-card__read-time">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
              </div>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>
{% schema %}
{
  "name": "Main blog",
  "settings": [
    {"type": "range", "id": "articles_per_page", "label": "Articles per page", "min": 3, "max": 24, "step": 3, "default": 9},
    {"type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 4, "step": 1, "default": 3}
  ]
}
{% endschema %}
