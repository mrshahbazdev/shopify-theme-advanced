<div class="image-banner image-banner--{{ section.settings.desktop_content_position }}">
  {%- if section.settings.image != blank -%}
    <div class="image-banner__media {% if section.settings.enable_parallax %}image-banner__media--parallax{% endif %}">
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="{{ section.settings.image.alt | escape }}" width="1920" loading="eager" class="image-banner__image desktop-only" height="{{ section.settings.image.height | times: 1.0 | divided_by: section.settings.image.width | times: 1920 | round }}">
      {%- if section.settings.image_mobile != blank -%}
        <img src="{{ section.settings.image_mobile | image_url: width: 800 }}" alt="{{ section.settings.image_mobile.alt | escape }}" width="800" loading="eager" class="image-banner__image mobile-only" height="{{ section.settings.image_mobile.height | times: 1.0 | divided_by: section.settings.image_mobile.width | times: 800 | round }}">
      {%- else -%}
        <img src="{{ section.settings.image | image_url: width: 800 }}" alt="{{ section.settings.image.alt | escape }}" width="800" loading="eager" class="image-banner__image mobile-only" height="{{ section.settings.image.height | times: 1.0 | divided_by: section.settings.image.width | times: 800 | round }}">
      {%- endif -%}
    </div>
    <div class="image-banner__overlay"></div>
  {%- endif -%}
  <div class="image-banner__content color-{{ section.settings.color_scheme }}">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}<h2 class="image-banner__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
      {%- if section.settings.text != blank -%}<div class="image-banner__text rte">{{ section.settings.text }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
        <a href="{{ section.settings.button_link }}" class="button button--primary">{{ section.settings.button_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Image banner",
  "settings": [
    {"type": "image_picker", "id": "image", "label": "Desktop image"},
    {"type": "image_picker", "id": "image_mobile", "label": "Mobile image"},
    {"type": "checkbox", "id": "enable_parallax", "label": "Enable parallax", "default": true},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Welcome"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your brand story with a bold hero banner.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Shop now"},
    {"type": "url", "id": "button_link", "label": "Button link"},
    {"type": "select", "id": "desktop_content_position", "label": "Content position", "options": [{"value": "center", "label": "Center"}, {"value": "left", "label": "Left"}, {"value": "right", "label": "Right"}], "default": "center"},
    {"type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{"value": "background-1", "label": "Light"}, {"value": "background-2", "label": "Light 2"}, {"value": "accent-1", "label": "Accent 1"}, {"value": "accent-2", "label": "Accent 2"}], "default": "background-1"}
  ],
  "presets": [{"name": "Image banner"}]
}
{% endschema %}
