<div class="page-404 page-width section-{{ section.id }}">
  <h1>{{ 'templates.404.title' | t }}</h1>
  <p>{{ 'templates.404.subtext' | t }}</p>
  <a href="{{ routes.root_url }}" class="button button--primary">{{ 'templates.404.continue_shopping' | t }}</a>
</div>
{% schema %}
{
  "name": "Main 404",
  "tag": "section",
  "class": "section"
}
{% endschema %}
