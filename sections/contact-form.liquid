<div class="contact-page section-{{ section.id }}">
  <div class="page-width">
    <div class="contact-page__header">
      <h1 class="contact-page__title">{{ page.title | escape }}</h1>
      {%- if section.settings.intro != blank -%}<p class="contact-page__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <div class="contact-page__grid">
      <div class="contact-page__form-wrapper">
        {%- form 'contact', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-form__success">{{ 'templates.contact.post_success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <ul class="contact-form__errors">
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="ContactName">{{ 'templates.contact.name' | t }}</label>
              <input type="text" id="ContactName" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" placeholder="Your name" required>
            </div>
            <div class="contact-form__field">
              <label for="ContactEmail">{{ 'templates.contact.email' | t }}</label>
              <input type="email" id="ContactEmail" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" placeholder="your@email.com" required>
            </div>
          </div>
          <div class="contact-form__field">
            <label for="ContactPhone">{{ 'templates.contact.phone' | t }}</label>
            <input type="tel" id="ContactPhone" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" placeholder="+1 234 567 890">
          </div>
          <div class="contact-form__field">
            <label for="ContactMessage">{{ 'templates.contact.message' | t }}</label>
            <textarea id="ContactMessage" name="contact[body]" rows="6" placeholder="How can we help?" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ 'templates.contact.send' | t }}</button>
        {%- endform -%}
      </div>
      <div class="contact-page__info">
        {%- if section.settings.show_store_info -%}
          <div class="contact-info">
            {%- if shop.name != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-store' %}</span>
                <div>
                  <h3>Store</h3>
                  <p>{{ shop.name }}</p>
                </div>
              </div>
            {%- endif -%}
            {%- if shop.address != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-pin' %}</span>
                <div>
                  <h3>Address</h3>
                  <address>{{ shop.address | format_address }}</address>
                </div>
              </div>
            {%- endif -%}
            {%- if shop.phone != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-phone' %}</span>
                <div>
                  <h3>Phone</h3>
                  <p><a href="tel:{{ shop.phone }}">{{ shop.phone }}</a></p>
                </div>
              </div>
            {%- endif -%}
            <div class="contact-info__item">
              <span class="contact-info__icon">{% render 'icon-email' %}</span>
              <div>
                <h3>Email</h3>
                <p><a href="mailto:{{ shop.email }}">{{ shop.email }}</a></p>
              </div>
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.map_embed != blank -%}
          <div class="contact-page__map">{{ section.settings.map_embed }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {"type": "textarea", "id": "intro", "label": "Intro text", "default": "Have a question? We'd love to hear from you."},
    {"type": "checkbox", "id": "show_store_info", "label": "Show store info", "default": true},
    {"type": "html", "id": "map_embed", "label": "Map embed code"}
  ],
  "presets": [{"name": "Contact form"}]
}
{% endschema %}
