<article class="article-page section-{{ section.id }}">
  <div class="page-width">
    <header class="article-page__header">
      {%- if article.tags.size > 0 -%}<span class="article-page__tag">{{ article.tags.first | escape }}</span>{%- endif -%}
      <h1 class="article-page__title">{{ article.title | escape }}</h1>
      <div class="article-page__meta">
        <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: '%B %d, %Y' }}</time>
        <span class="article-page__read-time">{{ article.content | strip_html | split: ' ' | size | divided_by: 200 | plus: 1 }} min read</span>
        {%- if article.author != blank -%}<span class="article-page__author">By {{ article.author | escape }}</span>{%- endif -%}
      </div>
    </header>
    {%- if article.image != blank -%}
      <div class="article-page__image">
        <img src="{{ article.image | image_url: width: 1600 }}" alt="{{ article.image.alt | escape }}" loading="eager" width="1600" height="{{ article.image.height | times: 1.0 | divided_by: article.image.width | times: 1600 | round }}">
      </div>
    {%- endif -%}
    <div class="article-page__content rte">{{ article.content }}</div>
    {%- if article.tags.size > 0 -%}
      <div class="article-page__tags">
        <span>Tags:</span>
        {%- for tag in article.tags -%}<span class="article-page__tag-pill">{{ tag | link_to_tag: tag }}</span>{%- endfor -%}
      </div>
    {%- endif -%}
    {%- if blog.previous_article or blog.next_article -%}
      <nav class="article-page__nav">
        {%- if blog.previous_article -%}<a href="{{ blog.previous_article.url }}" class="article-page__nav-link">&larr; {{ blog.previous_article.title | escape }}</a>{%- endif -%}
        {%- if blog.next_article -%}<a href="{{ blog.next_article.url }}" class="article-page__nav-link article-page__nav-link--next">{{ blog.next_article.title | escape }} &rarr;</a>{%- endif -%}
      </nav>
    {%- endif -%}
    {%- if blog.comments_enabled? -%}
      <div class="article-page__comments">
        <h2>Comments ({{ article.comments_count }})</h2>
        {%- if article.comments_count > 0 -%}
          <ul class="article-comments">
            {%- for comment in article.comments -%}
              <li class="article-comment">
                <p class="article-comment__author">{{ comment.author | escape }} <time>{{ comment.created_at | date: '%B %d, %Y' }}</time></p>
                <div class="article-comment__body">{{ comment.content }}</div>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- form 'new_comment', article -%}
          <div class="article-form__row">
            <div class="article-form__field"><label for="CommentAuthor">Name</label><input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" required></div>
            <div class="article-form__field"><label for="CommentEmail">Email</label><input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" required></div>
          </div>
          <div class="article-form__field"><label for="CommentBody">Comment</label><textarea id="CommentBody" name="comment[body]" rows="5" required>{% if form.body %}{{ form.body }}{% endif %}</textarea></div>
          <button type="submit" class="button button--primary">Post comment</button>
        {%- endform -%}
      </div>
    {%- endif -%}
  </div>
</article>
{% schema %}
{
  "name": "Main article",
  "settings": []
}
{% endschema %}
