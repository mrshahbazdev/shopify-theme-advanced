{%- liquid
  assign limit = section.settings.products_to_show | default: 4
  assign output_count = 0
-%}
{%- capture related_html -%}
  {%- if product.collections.size > 0 -%}
    {%- for p in product.collections.first.products -%}
      {%- if p.handle == product.handle -%}{%- continue -%}{%- endif -%}
      {%- if output_count >= limit -%}{%- break -%}{%- endif -%}
      {%- assign output_count = output_count | plus: 1 -%}
      {% render 'card-product', product: p %}
    {%- endfor -%}
  {%- endif -%}
  {%- if output_count < limit -%}
    {%- for p in collections.all.products -%}
      {%- if p.handle == product.handle -%}{%- continue -%}{%- endif -%}
      {%- if output_count >= limit -%}{%- break -%}{%- endif -%}
      {%- assign output_count = output_count | plus: 1 -%}
      {% render 'card-product', product: p %}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}
{%- if output_count > 0 -%}
<div class="related-products section-{{ section.id }}">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}<h2 class="section-title">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    <div class="related-products__grid">
      {{ related_html }}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
{
  "name": "Related products",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "You may also like"},
    {"type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4}
  ],
  "presets": [{"name": "Related products"}]
}
{% endschema %}
