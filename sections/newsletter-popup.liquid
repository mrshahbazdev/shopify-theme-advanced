<div class="popup popup--newsletter {% unless section.settings.enabled %}hidden{% endunless %}" data-newsletter-popup data-delay="{{ section.settings.delay }}" data-frequency="{{ section.settings.frequency }}" role="dialog" aria-label="Newsletter">
  <div class="popup__overlay js-popup-close"></div>
  <div class="popup__content">
    <button type="button" class="popup__close js-popup-close" aria-label="{{ 'general.search.close' | t }}">{% render 'icon-close' %}</button>
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 400 }}" alt="" class="popup__image" loading="lazy" width="400">
    {%- endif -%}
    <h2>{{ section.settings.heading | escape }}</h2>
    <div class="rte">{{ section.settings.text }}</div>
    {% form 'customer', class: 'popup__form' %}
      {{ form.errors | default_errors }}
      <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required>
      <button type="submit" class="button button--primary">{{ section.settings.button_label | default: 'Subscribe' | escape }}</button>
    {% endform %}
  </div>
</div>
{% schema %}
{
  "name": "Newsletter popup",
  "settings": [
    {"type": "checkbox", "id": "enabled", "label": "Enabled", "default": false},
    {"type": "image_picker", "id": "image", "label": "Image"},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Join the club"},
    {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Subscribe for exclusive offers and updates.</p>"},
    {"type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe"},
    {"type": "text", "id": "delay", "label": "Show delay (ms)", "default": "5000"},
    {"type": "text", "id": "frequency", "label": "Frequency (days)", "default": "7"}
  ]
}
{% endschema %}
