<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width footer__grid">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'link_list' -%}
            {%- assign block_menu = linklists[block.settings.menu] -%}
            {%- if block_menu -%}
            <h3 class="footer__title">{{ block.settings.heading | default: block_menu.title | escape }}</h3>
            <ul class="footer__list">
              {%- for link in block_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
            {%- endif -%}
          {%- when 'text' -%}
            <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
            <div class="rte">{{ block.settings.text }}</div>
          {%- when 'newsletter' -%}
            <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
            {% form 'customer', class: 'footer__newsletter' %}
              {{ form.errors | default_errors }}
              <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required>
              <button type="submit" class="button button--primary">{{ 'general.newsletter_form.submit' | t }}</button>
            {% endform %}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="page-width footer__bottom">
    <div class="footer__social">
      {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener">Facebook</a>{%- endif -%}
      {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
      {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener">Twitter</a>{%- endif -%}
      {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener">YouTube</a>{%- endif -%}
      {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
    </div>
    <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</p>
    <div class="footer__payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'icon' }}{% endfor %}</div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{"value": "accent-1", "label": "Accent 1"}, {"value": "accent-2", "label": "Accent 2"}, {"value": "background-1", "label": "Background 1"}, {"value": "background-2", "label": "Background 2"}], "default": "background-1"}
  ],
  "blocks": [
    {"type": "link_list", "name": "Menu", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "link_list", "id": "menu", "label": "Menu"}]},
    {"type": "text", "name": "Text", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "About us"}, {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Share store details, promotions, or brand content.</p>"}]},
    {"type": "newsletter", "name": "Newsletter", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Subscribe"}]}
  ],
  "presets": [{"name": "Footer"}]
}
{% endschema %}
