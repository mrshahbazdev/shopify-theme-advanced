<div class="contact-page section-{{ section.id }} color-scheme-{{ section.settings.color_scheme }}" style="{% if section.settings.background_color != blank %}background-color: {{ section.settings.background_color }};{% endif %}{% if section.settings.text_color != blank %}color: {{ section.settings.text_color }};{% endif %}">
  <div class="page-width">
    <div class="contact-page__header">
      <h1 class="contact-page__title">{% if section.settings.heading != blank %}{{ section.settings.heading | escape }}{% else %}{{ page.title | escape }}{% endif %}</h1>
      {%- if section.settings.intro != blank -%}<p class="contact-page__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
    </div>
    <div class="contact-page__grid">
      <div class="contact-page__form-wrapper">
        {%- form 'contact', class: 'contact-form' -%}
          {%- if form.posted_successfully? -%}
            <p class="contact-form__success">{{ section.settings.success_message | default: 'Thanks for contacting us. We\'ll get back to you soon.' }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <ul class="contact-form__errors">
              {%- for field in form.errors -%}
                <li>{{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          <div class="contact-form__row">
            <div class="contact-form__field">
              <label for="ContactName_{{ section.id }}">{{ 'templates.contact.name' | t }}</label>
              <input type="text" id="ContactName_{{ section.id }}" name="contact[name]" value="{% if form.name %}{{ form.name }}{% endif %}" placeholder="{{ section.settings.name_placeholder | escape }}" required>
            </div>
            <div class="contact-form__field">
              <label for="ContactEmail_{{ section.id }}">{{ 'templates.contact.email' | t }}</label>
              <input type="email" id="ContactEmail_{{ section.id }}" name="contact[email]" value="{% if form.email %}{{ form.email }}{% endif %}" placeholder="{{ section.settings.email_placeholder | escape }}" required>
            </div>
          </div>
          <div class="contact-form__field">
            <label for="ContactPhone_{{ section.id }}">{{ 'templates.contact.phone' | t }}</label>
            <input type="tel" id="ContactPhone_{{ section.id }}" name="contact[phone]" value="{% if form.phone %}{{ form.phone }}{% endif %}" placeholder="{{ section.settings.phone_placeholder | escape }}">
          </div>
          <div class="contact-form__field">
            <label for="ContactMessage_{{ section.id }}">{{ 'templates.contact.message' | t }}</label>
            <textarea id="ContactMessage_{{ section.id }}" name="contact[body]" rows="6" placeholder="{{ section.settings.message_placeholder | escape }}" required>{% if form.body %}{{ form.body }}{% endif %}</textarea>
          </div>
          <button type="submit" class="button button--primary">{{ section.settings.button_text | default: 'Send message' }}</button>
        {%- endform -%}
      </div>
      <div class="contact-page__info">
        {%- if section.settings.show_store_info -%}
          <div class="contact-info">
            {%- if section.settings.store_heading != blank -%}<h2 class="contact-info__title">{{ section.settings.store_heading | escape }}</h2>{%- endif -%}
            {%- assign address_html = section.settings.custom_address | default: shop.address | format_address -%}
            {%- if shop.name != blank or section.settings.store_name != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-store' %}</span>
                <div>
                  <h3>{{ 'templates.contact.store' | t }}</h3>
                  <p>{{ section.settings.store_name | default: shop.name | escape }}</p>
                </div>
              </div>
            {%- endif -%}
            {%- if address_html != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-pin' %}</span>
                <div>
                  <h3>{{ 'templates.contact.address' | t }}</h3>
                  <address>{{ address_html }}</address>
                </div>
              </div>
            {%- endif -%}
            {%- assign phone = section.settings.custom_phone | default: shop.phone -%}
            {%- if phone != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-phone' %}</span>
                <div>
                  <h3>{{ 'templates.contact.phone' | t }}</h3>
                  <p><a href="tel:{{ phone | handleize }}">{{ phone | escape }}</a></p>
                </div>
              </div>
            {%- endif -%}
            {%- assign email = section.settings.custom_email | default: shop.email -%}
            {%- if email != blank -%}
              <div class="contact-info__item">
                <span class="contact-info__icon">{% render 'icon-email' %}</span>
                <div>
                  <h3>{{ 'templates.contact.email' | t }}</h3>
                  <p><a href="mailto:{{ email }}">{{ email | escape }}</a></p>
                </div>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if section.settings.show_social -%}
          <div class="contact-social">
            {%- if section.settings.social_heading != blank -%}<h2 class="contact-social__title">{{ section.settings.social_heading | escape }}</h2>{%- endif -%}
            <div class="contact-social__links">
              {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon-facebook' %}</a>{%- endif -%}
              {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon-instagram' %}</a>{%- endif -%}
              {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">{% render 'icon-twitter' %}</a>{%- endif -%}
              {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon-youtube' %}</a>{%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon-tiktok' %}</a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}
        {%- if section.settings.map_embed != blank -%}
          <div class="contact-page__map">{{ section.settings.map_embed }}</div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact form",
  "settings": [
    {"type": "text", "id": "heading", "label": "Heading", "default": "", "info": "Leave blank to use the page title"},
    {"type": "textarea", "id": "intro", "label": "Intro text", "default": "Have a question? We'd love to hear from you. Send us a message and we'll respond as soon as possible."},
    {"type": "text", "id": "name_placeholder", "label": "Name placeholder", "default": "Your name"},
    {"type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "your@email.com"},
    {"type": "text", "id": "phone_placeholder", "label": "Phone placeholder", "default": "+1 234 567 890"},
    {"type": "text", "id": "message_placeholder", "label": "Message placeholder", "default": "How can we help?"},
    {"type": "text", "id": "button_text", "label": "Button text", "default": "Send message"},
    {"type": "text", "id": "success_message", "label": "Success message", "default": "Thanks for contacting us. We'll get back to you soon."},
    {"type": "checkbox", "id": "show_store_info", "label": "Show store info", "default": true},
    {"type": "text", "id": "store_heading", "label": "Store info heading", "default": "Get in touch"},
    {"type": "text", "id": "store_name", "label": "Store name", "default": "", "info": "Overrides Shopify store name"},
    {"type": "textarea", "id": "custom_address", "label": "Custom address", "default": "", "info": "Overrides Shopify store address"},
    {"type": "text", "id": "custom_phone", "label": "Custom phone", "default": "", "info": "Overrides Shopify store phone"},
    {"type": "text", "id": "custom_email", "label": "Custom email", "default": "", "info": "Overrides Shopify store email"},
    {"type": "checkbox", "id": "show_social", "label": "Show social links", "default": true},
    {"type": "text", "id": "social_heading", "label": "Social links heading", "default": "Follow us"},
    {"type": "html", "id": "map_embed", "label": "Map embed code"},
    {"type": "color", "id": "background_color", "label": "Background color", "default": "#ffffff"},
    {"type": "color", "id": "text_color", "label": "Text color", "default": "#1a1a1a"}
  ],
  "presets": [{"name": "Contact form"}]
}
{% endschema %}
