<div class="cart-item {% if compact %}cart-item--compact{% endif %}" data-cart-item data-line="{{ index }}">
  <div class="cart-item__image">
    {%- if item.image != blank -%}
      <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" loading="lazy" width="120" height="{{ item.image.height | times: 1.0 | divided_by: item.image.width | times: 120 | round }}">
    {%- endif -%}
  </div>
  <div class="cart-item__details">
    <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
    {%- unless item.variant.title == 'Default Title' -%}<p class="cart-item__variant">{{ item.variant.title | escape }}</p>{%- endunless -%}
    <p class="cart-item__price">{{ item.final_line_price | money }}</p>
    <div class="cart-item__qty">
      <button type="button" class="cart-item__qty-btn" data-qty-change="-1" data-line="{{ index }}" aria-label="{{ 'products.decrease_quantity' | t }}">-</button>
      <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-line="{{ index }}" class="cart-item__qty-input" aria-label="{{ 'products.quantity' | t }}">
      <button type="button" class="cart-item__qty-btn" data-qty-change="1" data-line="{{ index }}" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
    </div>
  </div>
  <button type="button" class="cart-item__remove" data-line-remove="{{ index }}" aria-label="{{ 'sections.cart.remove' | t }}">{% render 'icon-close' %}</button>
</div>
