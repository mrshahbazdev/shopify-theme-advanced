<div class="social-sharing">
  <span class="social-sharing__label">Share:</span>
  <a href="https://www.facebook.com/sharer/sharer.php?u={{ share_permalink | url_encode }}" target="_blank" rel="noopener" aria-label="Facebook">Facebook</a>
  <a href="https://twitter.com/intent/tweet?text={{ share_title | url_encode }}&url={{ share_permalink | url_encode }}" target="_blank" rel="noopener" aria-label="Twitter">Twitter</a>
  <a href="https://pinterest.com/pin/create/button/?url={{ share_permalink | url_encode }}&media={{ share_image | image_url: width: 800 | url_encode }}&description={{ share_title | url_encode }}" target="_blank" rel="noopener" aria-label="Pinterest">Pinterest</a>
  <a href="mailto:?subject={{ share_title | url_encode }}&body={{ share_permalink | url_encode }}" aria-label="Email">Email</a>
</div>
