{% layout 'theme' %}
<div class="page-width customer-auth">
  <h1>{{ 'customer.reset_password.title' | t }}</h1>
  <p>{{ 'customer.reset_password.subtext' | t }}</p>
  {% form 'reset_customer_password' %}
    {{ form.errors | default_errors }}
    <label for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
    <input type="password" name="customer[password]" id="ResetPassword" required>
    <label for="PasswordConfirmation">{{ 'customer.reset_password.password_confirm' | t }}</label>
    <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" required>
    <button type="submit" class="button button--primary">{{ 'customer.reset_password.submit' | t }}</button>
  {% endform %}
</div>
