<footer class="footer color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="footer__top">
      {%- if section.settings.show_branding -%}
        <div class="footer__brand">
          <a href="{{ routes.root_url }}" class="footer__logo">{{ shop.name }}</a>
          {%- if shop.description != blank -%}
            <p class="footer__tagline">{{ shop.description }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
      <div class="footer__grid">
        {%- for block in section.blocks -%}
          <div class="footer__block" {{ block.shopify_attributes }}>
            {%- case block.type -%}
              {%- when 'link_list' -%}
                {%- assign block_menu = linklists[block.settings.menu] -%}
                {%- if block_menu -%}
                  <h3 class="footer__title">{{ block.settings.heading | default: block_menu.title | escape }}</h3>
                  <ul class="footer__list">
                    {%- for link in block_menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
                <div class="rte footer__text">{{ block.settings.text }}</div>
              {%- when 'newsletter' -%}
                <h3 class="footer__title">{{ block.settings.heading | escape }}</h3>
                {%- if block.settings.subtext != blank -%}<p class="footer__newsletter-subtext">{{ block.settings.subtext | escape }}</p>{%- endif -%}
                {% form 'customer', class: 'footer__newsletter' %}
                  {{ form.errors | default_errors }}
                  <div class="footer__newsletter-inner">
                    <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter_form.newsletter_email' | t }}" required>
                    <button type="submit" class="button button--primary">{{ 'general.newsletter_form.submit' | t }}</button>
                  </div>
                {% endform %}
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>
    <div class="footer__bottom">
      {%- if section.settings.show_social -%}
        <div class="footer__social">
          {%- if settings.social_facebook_link != blank -%}<a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" aria-label="Facebook">{% render 'icon-facebook' %}</a>{%- endif -%}
          {%- if settings.social_instagram_link != blank -%}<a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" aria-label="Instagram">{% render 'icon-instagram' %}</a>{%- endif -%}
          {%- if settings.social_twitter_link != blank -%}<a href="{{ settings.social_twitter_link }}" target="_blank" rel="noopener" aria-label="Twitter">{% render 'icon-twitter' %}</a>{%- endif -%}
          {%- if settings.social_youtube_link != blank -%}<a href="{{ settings.social_youtube_link }}" target="_blank" rel="noopener" aria-label="YouTube">{% render 'icon-youtube' %}</a>{%- endif -%}
          {%- if settings.social_tiktok_link != blank -%}<a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" aria-label="TikTok">{% render 'icon-tiktok' %}</a>{%- endif -%}
        </div>
      {%- endif -%}
      <p class="footer__copyright">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}. All rights reserved.</p>
      <div class="footer__payment-icons">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'icon' }}{% endfor %}</div>
    </div>
  </div>
</footer>
{% schema %}
{
  "name": "Footer",
  "settings": [
    {"type": "select", "id": "color_scheme", "label": "Color scheme", "options": [{"value": "accent-1", "label": "Accent 1"}, {"value": "accent-2", "label": "Accent 2"}, {"value": "background-1", "label": "Background 1"}, {"value": "background-2", "label": "Background 2"}], "default": "background-1"},
    {"type": "checkbox", "id": "show_branding", "label": "Show shop branding", "default": true},
    {"type": "checkbox", "id": "show_social", "label": "Show social icons", "default": true}
  ],
  "blocks": [
    {"type": "link_list", "name": "Menu", "settings": [{"type": "text", "id": "heading", "label": "Heading"}, {"type": "link_list", "id": "menu", "label": "Menu"}]},
    {"type": "text", "name": "Text", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "About us"}, {"type": "richtext", "id": "text", "label": "Text", "default": "<p>Share store details, promotions, or brand content.</p>"}]},
    {"type": "newsletter", "name": "Newsletter", "settings": [{"type": "text", "id": "heading", "label": "Heading", "default": "Subscribe"}, {"type": "text", "id": "subtext", "label": "Subtext", "default": "Get the latest news and deals."}]}
  ],
  "presets": [{"name": "Footer"}]
}
{% endschema %}
