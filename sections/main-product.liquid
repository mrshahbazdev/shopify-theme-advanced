{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="product-page page-width section-{{ section.id }}">
  <div class="product-page__grid">
    <div class="product-page__media" data-product-media>
      {%- if product.media.size > 0 -%}
        <div class="product-media__wrapper {% if product.media.size > 1 %}product-media__wrapper--has-thumbs{% endif %}">
          <div class="product-media__stage">
            {%- for media in product.media -%}
              <div class="product-media__item {% if forloop.first %}product-media__item--active{% endif %}" data-media-id="{{ media.id }}">
                {%- case media.media_type -%}
                  {%- when 'image' -%}
                    <button type="button" class="product-media__zoom" data-lightbox-open aria-label="Open image">
                      <img src="{{ media | image_url: width: 1600 }}" alt="{{ media.alt | escape }}" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="1600" height="{{ media.preview_image.height | times: 1.0 | divided_by: media.preview_image.width | times: 1600 | round }}">
                    </button>
                  {%- when 'video' -%}
                    {{ media | video_tag: controls: true, class: 'product-media__video' }}
                  {%- when 'external_video' -%}
                    {{ media | external_video_tag: class: 'product-media__video' }}
                  {%- when 'model' -%}
                    {{ media | model_viewer_tag }}
                {%- endcase -%}
              </div>
            {%- endfor -%}
          </div>
          {%- if product.media.size > 1 -%}
            <div class="product-media__thumbnails product-media__thumbnails--vertical">
              {%- for media in product.media -%}
                <button type="button" class="product-media__thumb {% if forloop.first %}product-media__thumb--active{% endif %}" data-media-id="{{ media.id }}" aria-label="View media {{ forloop.index }}">
                  {%- if media.media_type == 'image' -%}
                    <img src="{{ media | image_url: width: 160 }}" alt="" loading="lazy" width="160" height="{{ media.preview_image.height | times: 1.0 | divided_by: media.preview_image.width | times: 160 | round }}">
                  {%- else -%}
                    <span class="product-media__thumb-icon">Video</span>
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
    <div class="product-page__info" {% if section.settings.enable_sticky_atc %}data-sticky-info{% endif %}>
      {%- if section.settings.show_vendor and product.vendor != blank -%}
        <p class="product__vendor">{{ product.vendor | link_to_vendor }}</p>
      {%- endif -%}
      <h1 class="product__title">{{ product.title | escape }}</h1>
      <div class="product__price" data-product-price>{% render 'price', product: product, variant: current_variant %}</div>
      <ul class="product__meta">
        {%- if section.settings.show_sku and current_variant.sku != blank -%}
          <li><span class="product__meta-label">SKU:</span> {{ current_variant.sku | escape }}</li>
        {%- endif -%}
        {%- if section.settings.show_inventory -%}
          <li>
            <span class="product__meta-label">Availability:</span>
            {%- if current_variant.inventory_quantity > 0 -%}
              <span class="product__stock product__stock--in">{{ current_variant.inventory_quantity }} in stock</span>
            {%- elsif current_variant.available -%}
              <span class="product__stock product__stock--in">In stock</span>
            {%- else -%}
              <span class="product__stock product__stock--out">Out of stock</span>
            {%- endif -%}
          </li>
        {%- endif -%}
      </ul>
      {% form 'product', product, id: 'product-form', class: 'product-form js-product-form', novalidate: 'novalidate' %}
        {%- unless product.has_only_default_variant -%}
          <div class="product-form__variants" data-product-options>
            {%- for option in product.options_with_values -%}
              <div class="product-form__option">
                <div class="product-form__option-header">
                  <label class="form__label" for="Option-{{ section.id }}-{{ forloop.index0 }}">{{ option.name | escape }}</label>
                  {%- if option.name == 'Size' and section.settings.size_chart_page != blank -%}
                    <a href="{{ section.settings.size_chart_page }}" class="product-form__size-chart" target="_blank">Size guide</a>
                  {%- endif -%}
                </div>
                {%- if section.settings.enable_swatches -%}
                  {%- case option.name -%}
                    {%- when 'Color', 'Colour' -%}
                      <div class="swatches" data-option-index="{{ forloop.index0 }}">
                        {%- for value in option.values -%}
                          <label class="swatch" title="{{ value | escape }}">
                            <input type="radio" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %} data-option-value data-option-index="{{ forloop.parentloop.index0 }}">
                            {%- capture color_value -%}{% render 'swatch-color', value: value %}{%- endcapture -%}
                            <span class="swatch__visual" style="background-color: {{ color_value | strip }};"></span>
                          </label>
                        {%- endfor -%}
                      </div>
                    {%- else -%}
                      <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="option{{ forloop.index }}" class="select" data-option-index="{{ forloop.index0 }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>
                        {%- endfor -%}
                      </select>
                  {%- endcase -%}
                {%- else -%}
                  <select id="Option-{{ section.id }}-{{ forloop.index0 }}" name="option{{ forloop.index }}" class="select" data-option-index="{{ forloop.index0 }}">
                    {%- for value in option.values -%}
                      <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value | escape }}</option>
                    {%- endfor -%}
                  </select>
                {%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endunless -%}
        <select name="id" class="product-form__id" data-variant-select hidden>
          {%- for variant in product.variants -%}
            <option value="{{ variant.id }}" data-options="{{ variant.option1 | escape }}|{{ variant.option2 | escape }}|{{ variant.option3 | escape }}" data-available="{{ variant.available }}" data-price="{{ variant.price }}" data-compare="{{ variant.compare_at_price }}" {% if variant == current_variant %}selected{% endif %}>{{ variant.title }} - {{ variant.price | money }}</option>
          {%- endfor -%}
        </select>
        <div class="product-form__quantity">
          <label class="form__label" for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
          <div class="quantity-selector">
            <button type="button" class="quantity-selector__btn" data-qty-decrement aria-label="Decrease quantity">-</button>
            <input type="number" id="Quantity-{{ section.id }}" name="quantity" value="1" min="1" class="quantity-input" data-quantity-input>
            <button type="button" class="quantity-selector__btn" data-qty-increment aria-label="Increase quantity">+</button>
          </div>
        </div>
        <div class="product-form__buttons">
          <button type="submit" name="add" class="button button--primary product-form__submit" data-add-to-cart {% if current_variant.available == false %}disabled{% endif %}>
            {%- if current_variant.available -%}{{ 'products.add_to_cart' | t }}{%- else -%}{{ 'products.sold_out' | t }}{%- endif -%}
          </button>
          {{ form | payment_button }}
        </div>
        <p class="product-form__error" data-form-error></p>
      {% endform %}
      <ul class="product__trust">
        <li>{% render 'icon-check' %} Free shipping over $50</li>
        <li>{% render 'icon-check' %} Secure checkout</li>
        <li>{% render 'icon-check' %} 30-day easy returns</li>
      </ul>
      {%- if section.settings.enable_tabs -%}
        <div class="product-tabs">
          {%- if product.description != blank -%}
            <details class="product-tab" open>
              <summary>Description</summary>
              <div class="rte">{{ product.description }}</div>
            </details>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'tab' -%}
              <details class="product-tab" {{ block.shopify_attributes }} {% if forloop.first and product.description == blank %}open{% endif %}>
                <summary>{{ block.settings.heading | escape }}</summary>
                <div class="rte">{{ block.settings.content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
          <details class="product-tab">
            <summary>Shipping & Returns</summary>
            <div class="rte"><p>Free standard shipping on orders over $50. Express options available at checkout. Returns accepted within 30 days.</p></div>
          </details>
        </div>
      {%- else -%}
        <div class="product__description rte">{{ product.description }}</div>
      {%- endif -%}
      {%- if section.settings.show_share_buttons -%}
        <div class="product__share">
          {% render 'social-sharing', share_title: product.title, share_permalink: product.url, share_image: product.featured_image %}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{%- if product.media.size > 0 -%}
<div class="product-lightbox" data-lightbox>
  <button type="button" class="product-lightbox__close" data-lightbox-close aria-label="Close">&times;</button>
  <img src="{{ product.media.first | image_url: width: 1600 }}" alt="{{ product.media.first.alt | escape }}" class="product-lightbox__img" data-lightbox-img width="1600" height="{{ product.media.first.preview_image.height | times: 1.0 | divided_by: product.media.first.preview_image.width | times: 1600 | round }}">
</div>
{%- endif -%}
{%- if section.settings.enable_sticky_atc -%}
  <div class="product-sticky-atc" data-sticky-atc>
    <div class="page-width product-sticky-atc__inner">
      {%- if product.featured_image != blank -%}
        <img src="{{ product.featured_image | image_url: width: 80 }}" alt="" loading="lazy" width="80" height="{{ product.featured_image.height | times: 1.0 | divided_by: product.featured_image.width | times: 80 | round }}">
      {%- endif -%}
      <div class="product-sticky-atc__details">
        <h4>{{ product.title | escape }}</h4>
        <span data-sticky-price>{% render 'price', product: product, variant: current_variant %}</span>
      </div>
      <button type="button" class="button button--primary" data-sticky-add>{{ 'products.add_to_cart' | t }}</button>
    </div>
  </div>
{%- endif -%}
<script type="application/json" data-product-variants>{{ product.variants | json }}</script>
<script type="application/json" data-product-options>{{ product.options | json }}</script>
{% schema %}
{
  "name": "Main product",
  "tag": "section",
  "class": "section",
  "blocks": [
    {"type": "tab", "name": "Tab", "settings": [
      {"type": "text", "id": "heading", "label": "Heading", "default": "Details"},
      {"type": "richtext", "id": "content", "label": "Content", "default": "<p>Add product details here.</p>"}
    ]}
  ],
  "settings": [
    {"type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true},
    {"type": "checkbox", "id": "show_sku", "label": "Show SKU", "default": false},
    {"type": "checkbox", "id": "show_inventory", "label": "Show inventory", "default": true},
    {"type": "checkbox", "id": "enable_swatches", "label": "Enable color swatches", "default": true},
    {"type": "checkbox", "id": "enable_tabs", "label": "Enable product tabs", "default": true},
    {"type": "checkbox", "id": "show_share_buttons", "label": "Show share buttons", "default": true},
    {"type": "checkbox", "id": "enable_sticky_atc", "label": "Enable sticky add to cart", "default": true},
    {"type": "url", "id": "size_chart_page", "label": "Size chart page"}
  ]
}
{% endschema %}
